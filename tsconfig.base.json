{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    // `${configDir}` 让每个子项目把声明产物落到自己的 dist-types/，
    // 而不是全部塌到仓库根（否则 tsbuildinfo 互相覆盖）。
    "outDir": "${configDir}/dist-types",
    // 增量状态必须和产物同生共死：放在 dist-types/ 内，否则删产物后
    // tsc -b 会因残留的 tsbuildinfo 认为"已是最新"而跳过 emit，下游解析直接失败。
    "tsBuildInfoFile": "${configDir}/dist-types/tsconfig.tsbuildinfo",
    // 施工单 00 §10：包内相对导入带 `.ts`；由 emit 阶段改写为 `.js`，
    // 保证产物面仍是合法的 Node ESM。
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}
