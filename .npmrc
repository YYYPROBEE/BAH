# 子路径导出需要 dev 虚拟仓；跨包引用一律 workspace 协议
link-workspace-packages=true

# Electron 二进制镜像（桌面端 02 / R-DT-01）。
# WHY 必须写在这里而不是"下载失败时手工放缓存"：本机 github.com:443 不通，
# Electron 的默认下载源是 github releases；不配镜像 → `pnpm install` 在 postinstall
# 阶段卡死或失败，而失败信息只说 "Electron failed to install correctly"，看不出是网络。
# 镜像只影响**二进制**下载；npm 包本身仍走 registry。
electron_mirror=https://npmmirror.com/mirrors/electron/
