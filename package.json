{
  "name": "bah-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -b && pnpm -r --filter \"./packages/*\" run build:bundle",
    "typecheck": "tsc -b tsconfig.host.json && tsc -b tsconfig.client.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "snapshot:record": "node scripts/record-snapshot.mjs",
    "test:web": "vitest run --config vitest.web.config.ts",
    "check": "tsx scripts/ci.ts",
    "check:ci": "tsx scripts/ci.ts --ci",
    "check:full": "pnpm check && pnpm rag:check",
    "gate": "tsx scripts/run-gates.ts",
    "bah": "tsx packages/cli/src/main.ts",
    "audit:selftest": "tsx scripts/audit-selftest.ts",
    "tool-catalog": "tsx scripts/build-tool-catalog.ts",
    "sentry:fp": "tsx scripts/sentry-fp-scan.ts",
    "rag:dev": "node scripts/rag.mjs dev",
    "rag:test": "node scripts/rag.mjs test",
    "rag:check": "node scripts/rag.mjs check",
    "rag:ingest": "node scripts/rag.mjs ingest",
    "rag:contract": "node scripts/rag.mjs contract",
    "demo:rag": "node scripts/demo-rag.mjs",
    "lint": "eslint \"packages/*/src/**/*.ts\"",
    "web": "tsx packages/cli/src/main.ts --profile web --serve"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9.39.4",
    "jsdom": "^26",
    "tsdown": "^0.12",
    "tsx": "^4",
    "typescript": "^5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3",
    "yaml": "^2"
  }
}
