{
  "name": "bah",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -b && pnpm -r --filter \"./packages/*\" run build:bundle",
    "typecheck": "tsc -b tsconfig.host.json && tsc -b tsconfig.client.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "vitest run --coverage --config vitest.coverage.config.ts && tsx scripts/coverage-summary.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "snapshot:record": "node scripts/record-snapshot.mjs",
    "snapshot:reverify": "tsx scripts/snapshot-reverify.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "check": "tsx scripts/ci.ts",
    "check:ci": "tsx scripts/ci.ts --ci",
    "check:full": "pnpm check && pnpm rag:check",
    "gate": "tsx scripts/run-gates.ts",
    "policy:lint": "tsx scripts/policy-lint.ts",
    "policy:compile": "tsx scripts/policy-compile.ts",
    "policy:test": "tsx scripts/policy-test.ts",
    "policy:versions": "tsx scripts/policy-admin.ts versions",
    "policy:install": "tsx scripts/policy-admin.ts install",
    "policy:promote": "tsx scripts/policy-admin.ts promote",
    "policy:rollback": "tsx scripts/policy-admin.ts rollback",
    "policy:reload": "tsx scripts/policy-admin.ts reload",
    "policy:audit-verify": "tsx scripts/policy-admin.ts audit-verify",
    "policy:explain": "tsx scripts/policy-explain.ts",
    "policy:shadow": "tsx scripts/policy-shadow.ts",
    "policy:keygen": "tsx scripts/policy-keygen.ts",
    "policy:sign": "tsx scripts/policy-sign.ts",
    "bench:policy": "tsx scripts/bench-policy.ts",
    "bah": "tsx packages/cli/src/main.ts",
    "im:gateway": "tsx apps/im-gateway/src/main.ts",
    "demo:intent": "tsx packages/cli/src/demo/intent.ts",
    "audit:selftest": "tsx scripts/audit-selftest.ts",
    "tool-catalog": "tsx scripts/build-tool-catalog.ts",
    "sentry:fp": "tsx scripts/sentry-fp-scan.ts",
    "rag:dev": "node scripts/rag.mjs dev",
    "rag:test": "node scripts/rag.mjs test",
    "rag:check": "node scripts/rag.mjs check",
    "rag:ingest": "node scripts/rag.mjs ingest",
    "rag:contract": "node scripts/rag.mjs contract",
    "demo:rag": "node scripts/demo-rag.mjs",
    "demo:verifier-fail": "tsx scripts/demo-verifier-fail.ts",
    "lint": "eslint \"packages/*/src/**/*.ts\" \"scripts/**/*.ts\"",
    "web": "tsx packages/cli/src/main.ts --profile web --serve",
    "web-plan": "tsx packages/cli/src/main.ts --profile web-plan --serve",
    "demo:web": "node scripts/demo-web.mjs",
    "demo:mobile": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs packages/cli/src/main.ts --profile mobile --serve",
    "demo:im": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs apps/im-gateway/src/main.ts",
    "demo:desktop": "node scripts/demo-desktop.mjs",
    "handoff:demo": "tsx scripts/demo-handoff.ts",
    "knowledge:sign": "tsx scripts/sign-knowledge.ts",
    "eval": "tsx scripts/eval.ts",
    "replay": "tsx scripts/replay.ts",
    "eval:unit": "vitest run --config vitest.eval.config.ts",
    "eval:smoke": "tsx scripts/eval.ts --smoke",
    "eval:baseline": "tsx scripts/eval.ts --baseline-check",
    "eval:baseline:record": "tsx scripts/eval.ts --baseline-record",
    "evidence:replay": "tsx scripts/replay.ts",
    "desktop:build": "pnpm -F @bah/desktop run build",
    "desktop:dev": "pnpm -F @bah/desktop run build && pnpm -F @bah/desktop run start",
    "desktop:smoke": "tsx scripts/desktop-channel.test.ts",
    "desktop:pack": "tsx scripts/pack-desktop.mjs",
    "desktop:accept": "node scripts/desktop-acceptance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3",
    "eslint": "^9.39.4",
    "jsdom": "^26",
    "tsdown": "^0.12",
    "tsx": "^4",
    "typescript": "^5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3",
    "yaml": "^2"
  },
  "pnpm": {
    "overrides": {
      "tinypool": "^2.2.0"
    },
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
